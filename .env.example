# Server
PORT=8001
NODE_ENV=development
LOG_LEVEL=debug
API_KEY=test

# JWT Configuration
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7

# Database
# Match values with docker.env except PORT 
# PORT is kept as 5477 in docker-compose.yaml
DB_HOST=localhost
DB_PORT=5477
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=ally_local 

# AI Service
AI_SERVICE_API_URL=http://localhost:3001
# When ally-be runs in Docker and ally-ai-learn on host, use host.docker.internal.
# When ally-be runs on host (npm), use localhost. Production: set to prod URL.
AI_LEARN_SERVICE_API_URL=http://host.docker.internal:8002

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=your_redis_prefix_here

# OTP
OTP_TTL=300  #in seconds

# ANALYTICS
ANALYTICS_INTEGRATION=METABASE
METABASE_URL=https://metabase.com
METABASE_API_KEY=your_metabase_api_key_here

# AWS_SMTP
SMTP_REGION=smtp-region
SMTP_ACCESS_KEY_ID=smtp-access-key-id
SMTP_SECRET_ACCESS_KEY=smtp-secret-access-key

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=aws-access-key-id
AWS_SECRET_ACCESS_KEY=aws-secret-access-key
AWS_SESSION_TOKEN=aws-session-token
AWS_ENDPOINT_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566

# AWS-SES
SOURCE_EMAIL=source-email

# Audio upload
AUDIO_STORAGE_S3_BUCKET=audio-storage-s3-bucket

# AI service API key
AI_SERVICE_OUTBOUND_API_KEY=ai-service-outbound-key
AI_LEARN_SERVICE_OUTBOUND_API_KEY=ai-learn-service-outbound-key

# Audio storage directiry
AUDIO_STORAGE_DIR=audio-storage

# Cloud telephony credentials encryption key
CLOUD_TELEPHONY_CREDENTIALS_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

PHI_DATA_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Ozonetel API URL
OZONETEL_API_URL=ozonetel-api-url

# API base URL
API_BASE_URL=http://localhost:8001/
# AWS-SQS
SQS_TRANSCRIPTION_REQUEST_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sqs-ai-transcription-request-queue
SQS_TRANSCRIPTION_REQUEST_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sqs-ai-transcription-request-dlq
SQS_AUDIO_FILE_RETRY_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sqs-audio-file-retry-queue
SQS_AUDIO_FILE_RETRY_DLQ_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sqs-audio-file-retry-queue-dlq
SQS_LEARN_MESSAGE_AND_EVENT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sqs-learn-message-and-event-queue

# Cloudwatch
CLOUDWATCH_HIPAA_LOG_GROUP_NAME=/aws/hipaa/ally-dev-sg-core
CLOUDWATCH_HIPAA_LOG_STREAM_NAME=hipaa-audit-logs

# TEST ACCOUNTS
TEST_ACCOUNTS=test-accounts

# HIPAA
ENABLE_AUDIT_LOGS_TO_CLOUDWATCH=false
ENABLE_CONSOLE_AUDIT_LOGS=false
#CORS ORIGINS(comma seperated)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:3000

# Local dev: allow frontend-triggered agent dispatch when LiveKit webhook cannot reach localhost.
# Set to true on your machine, or use NODE_ENV=local. Not auto-enabled for NODE_ENV=development (dev server).
# ALLOW_DIRECT_AGENT_DISPATCH=true

# LIVEKIT CONFIG
LIVEKIT_URL=livekit-server-url
LIVEKIT_API_KEY=livekit-api-key
LIVEKIT_API_SECRET=livekit-api-secret

# APP base URL
APP_BASE_URL=app-base-url

# Admin API base URL
ADMIN_APP_BASE_URL=admin-app-base-url

# Simulation Credits
SIMULATION_SESSION_SECONDS_PER_CREDIT=60

#  Simulation Concurrency
MAX_CONCURRENT_SIMULATIONS=100

# LEARN MEDIA UPLOAD BUCKET 
LEARN_MEDIA_PUBLIC_S3_BUCKET=learn-media-public-s3-bucket

# ASSETS BUCKET
ASSETS_S3_BUCKET=assets-s3-bucket

#SCENARIO PATH ITEM COMPLETION MIN DURATION IN SECONDS
SCENARIO_PATH_ITEM_MIN_DURATION_FOR_COMPLETION=180


# CASE ITEM COMPLETION MIN DURATION IN SECONDS
CASE_ITEM_MIN_DURATION_FOR_COMPLETION=180

# Google Translation Configuration
# JSON path for service account credentials
GOOGLE_APPLICATION_CREDENTIALS=gcloud/application_default_credentials.json
# GCP Project ID
PROJECT_ID=your-gcp-project-id

#Google auth client ids
GOOGLE_WEB_CLIENT_ID=google-web-client-id
GOOGLE_IOS_CLIENT_ID=google-ios-client-id
GOOGLE_ANDROID_CLIENT_ID=google-android-client-id

OPENAI_API_KEY=openai-api-key
OPENAI_TRANSLATION_MODEL=gpt-4-translation-model
OPENAI_AUTOFILL_MODEL=gpt-5-mini

FEATURE_SCENARIO_SESSION_EVALUATION=true
FEATURE_SCENARIO_BEHAVIOR_STATE_INSTRUCTIONS=true

