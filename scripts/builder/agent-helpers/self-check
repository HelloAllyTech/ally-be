#!/usr/bin/env bash
# self-check [repo] — run the test gate's own checks on the tree as it stands.
#
# Typecheck, lint, tests, and the integrity, scope and tests-added checks,
# with each repo's own commands and Node: exactly what the gate runs after you
# stop, minus posting a verdict. Run it before you stop, for each repo you
# changed, and fix what it reports. A failure you can see here costs a turn; one
# the gate finds costs a whole attempt.
#
# Tests can take minutes: give your shell tool a long timeout for this command.
set -uo pipefail
. "$(dirname "$0")/_common.sh"
[ $# -le 1 ] || usage "self-check [repo]"

here="$(cd "$(dirname "$0")/.." && pwd)"
export ALLY_BE_API_URL ALLY_BE_API_KEY BUILDER_RUN_ID
cd "${BUILDER_WORKSPACE:-$PWD}" || exit 2

GATE_SELF_CHECK=1 GATE_ONLY_REPO="${1:-}" "${here}/run-test-gate.sh"
rc=$?

# What run-engine.sh reads to decide whether the coder checked what it is
# handing over: the result, and the tree it was for. Only a whole-tree check
# counts — one repo passing says nothing about the others.
if [ -z "${1:-}" ]; then
  printf '%s %s\n' "$([ "$rc" = 0 ] && echo pass || echo fail)" "$("${here}/tree-fingerprint.sh")" \
    > "${BUILDER_SELFCHECK_STAMP:-/tmp/builder-selfcheck.stamp}"
fi
exit "$rc"
