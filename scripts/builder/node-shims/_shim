#!/usr/bin/env bash
#
# `node`, `npm` and `npx` on the coding agent's PATH, resolved to the Node the
# repo it is standing in pins.
#
# The runner's default Node is 24 (ally-be's); ally-web pins 22. The gate has
# always switched per repo (repo-node.sh), but the agent's own shell did not,
# so `cd repos/ally-web && npx vitest` ran on 24 — where jsdom's AbortSignal is
# rejected — and session 880e73e6 (2026-10-12) "fixed" previewVoice.test.ts
# and productRoadmap.test.ts, which only fail on the wrong Node.
#
# node, npm and npx are symlinks to this file. It drops itself from PATH, finds
# the nearest .nvmrc above the working directory, lets use_repo_node prepend
# that Node's bin dir, and execs the real tool — so everything the tool spawns
# inherits the same Node without passing through here again. No .nvmrc, or the
# pinned major not installed: the runner's default, exactly as before.
set -u

name="$(basename "$0")"
shims="$(cd "$(dirname "$0")" && pwd -P)"

# Compared physically, so a PATH that spells this directory differently (a
# symlinked checkout, a trailing slash) cannot leave it in and loop.
kept=""
IFS=: read -r -a entries <<< "$PATH"
for entry in "${entries[@]}"; do
  [ "$(cd "$entry" 2>/dev/null && pwd -P)" = "$shims" ] && continue
  kept="${kept:+${kept}:}${entry}"
done
PATH="$kept"
export PATH

dir="$PWD"
while [ "$dir" != "/" ] && [ ! -f "${dir}/.nvmrc" ]; do
  dir="$(dirname "$dir")"
done
if [ -f "${dir}/.nvmrc" ]; then
  # shellcheck source=../repo-node.sh
  . "${shims}/../repo-node.sh"
  use_repo_node "$dir" 2>/dev/null || true
fi

exec "$name" "$@"
